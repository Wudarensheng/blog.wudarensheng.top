---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import GiscusComment from "@components/misc/Giscus.astro";
import { friends } from "@components/FriendsData.astro";
import { Icon } from "astro-icon/components";
---

<MainGridLayout title="友链" description="认识更多的朋友">
  <div class="card-base p-6">
    <!-- Header -->
    <div class="flex items-center mb-2">
      <Icon name="material-symbols:groups" class="text-3xl mr-3 text-gray-900 dark:text-white" />
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">友链</h1>
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-8">认识更多的朋友</p>

    <!-- Friends List -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {friends.map(friend => (
        <a 
          href={friend.link} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="block bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-lg p-4 transition-transform duration-300 ease-in-out hover:scale-105"
        >
          <div class="flex items-center">
            <img 
              src={friend.avatar} 
              alt={friend.name} 
              class="w-16 h-16 rounded-full mr-4 border-2 border-gray-200 dark:border-gray-700" 
            />
            <div class="flex-grow">
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white">{friend.name}</h2>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{friend.desc}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- How to Add Friend Link -->
    <div class="border-t border-gray-200 dark:border-gray-700 pt-8 mt-8">
      <h2 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white text-center">交换友链</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center mb-8">
        <!-- Left side: Code block -->
        <div>
          <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">1. 添加我的友链</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">请先将我的博客添加到你的网站中，格式如下：</p>
          <div class="relative group">
            <div class="bg-gray-900 p-4 rounded-lg text-white">
              <pre id="code-block" class="overflow-x-auto text-sm font-mono"><code>{`{
  "name": "无大人生",
  "avatar": "https://q2.qlogo.cn/headimg_dl?dst_uin=3574552394&spec=0",
  "link": "https://wudarensheng.top/",
  "desc": "远赴人间惊鸿宴，一睹人间盛世颜。"
}`}</code></pre>
            </div>
            <button id="copy-button" class="absolute top-3 right-3 p-1.5 bg-gray-700 rounded-md text-gray-300 hover:bg-gray-600 opacity-0 group-hover:opacity-100 transition-all duration-300" title="复制">
                <Icon name="material-symbols:content-copy-outline" class="w-5 h-5" />
            </button>
          </div>
        </div>
        <!-- Right side: Preview -->
        <div>
            <h3 class="text-lg font-semibold mb-2 text-gray-900 dark:text-white">显示效果</h3>
            <div class="block bg-white dark:bg-gray-800 rounded-lg shadow-md p-4">
                <div class="flex items-center">
                    <img src="https://q2.qlogo.cn/headimg_dl?dst_uin=3574552394&spec=0" alt="无大人生" class="w-16 h-16 rounded-full mr-4 border-2 border-gray-200 dark:border-gray-700" />
                    <div class="flex-grow">
                        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">无大人生</h2>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">远赴人间惊鸿宴，一睹人间盛世颜。</p>
                    </div>
                </div>
            </div>
        </div>
      </div>

      <h3 class="text-lg font-semibold mt-8 mb-4 text-gray-900 dark:text-white">2. 申请要求</h3>
        <div class="space-y-4 text-sm text-gray-600 dark:text-gray-400">
            <div class="p-4 border-l-4 border-blue-500 bg-blue-50 dark:bg-gray-800 rounded-r-lg">
                <h4 class="font-bold text-gray-900 dark:text-white mb-1">内容质量</h4>
                <p>本站优先收录技术、生活、设计等领域的原创博客。请确保您的网站内容健康、积极，不包含任何违反法律法规的内容。</p>
            </div>
            <div class="p-4 border-l-4 border-green-500 bg-green-50 dark:bg-gray-800 rounded-r-lg">
                <h4 class="font-bold text-gray-900 dark:text-white mb-1">技术标准</h4>
                <ul class="list-disc list-inside space-y-1">
                    <li>必须启用 <code class="font-mono text-xs bg-gray-200 dark:bg-gray-700 px-1 py-0.5 rounded">HTTPS</code> 协议。</li>
                    <li>网站需稳定运行，在中国大陆有较好的访问速度。</li>
                    <li>界面设计整洁、美观，具有良好的阅读体验。</li>
                </ul>
            </div>
            <div class="p-4 border-l-4 border-purple-500 bg-purple-50 dark:bg-gray-800 rounded-r-lg">
                <h4 class="font-bold text-gray-900 dark:text-white mb-1">活跃度与原创性</h4>
                <p>我们希望交换的是一个“活”的网站。您的博客需要定期更新，且原创内容占多数。</p>
            </div>
        </div>

      <h3 class="text-lg font-semibold mt-8 mb-4 text-gray-900 dark:text-white">3. 提交申请</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">在满足以上所有条件后，请在本页下方的评论区留言。我会尽快审核并添加您的友链。</p>
    </div>

    <!-- Giscus Comment -->
    <div class="mt-8">
      <GiscusComment
        repo="Wudarensheng/GISCUS-SYSTEM"
        repoId="R_kgDORHaZEg"
        category="Announcements"
        categoryId="DIC_kwDORHaZEs4C1zmv"
      />
    </div>
  </div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyButton = document.getElementById('copy-button');
    const codeBlock = document.getElementById('code-block');

    if (copyButton && codeBlock) {
      copyButton.addEventListener('click', () => {
        const codeToCopy = codeBlock.querySelector('code').innerText;
        navigator.clipboard.writeText(codeToCopy).then(() => {
          const originalIcon = copyButton.innerHTML;
          const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24"><path fill="currentColor" d="m9.55 18l-5.7-5.7l1.425-1.425L9.55 15.15l9.175-9.175L20.15 7.4z"/></svg>`;
          copyButton.innerHTML = checkIcon;
          copyButton.setAttribute('title', '已复制!');
          setTimeout(() => {
            copyButton.innerHTML = originalIcon;
            copyButton.setAttribute('title', '复制');
          }, 2000);
        }).catch(err => {
          console.error('无法复制到剪贴板: ', err);
          copyButton.setAttribute('title', '复制失败');
        });
      });
    }
  });
</script>
<style>
  #code-block::-webkit-scrollbar {
    height: 8px;
  }
  #code-block::-webkit-scrollbar-track {
    background: #1f2937; /* bg-gray-800 */
    border-radius: 10px;
  }
  #code-block::-webkit-scrollbar-thumb {
    background: #4b5563; /* bg-gray-600 */
    border-radius: 10px;
  }
  #code-block::-webkit-scrollbar-thumb:hover {
    background: #6b7280; /* bg-gray-500 */
  }
</style>
</MainGridLayout>
