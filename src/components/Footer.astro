---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
import { Image } from "astro:assets";
import cflogo from "@assets/images/cflogo.svg";

const currentYear = new Date().getFullYear();
---

<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<div class="transition bg-black/50 dark:bg-black/20 border border-black/10 dark:border-white/15 rounded-2xl mb-12 flex flex-row items-center justify-center space-x-16 px-6 py-8">
    <div class="transition text-50 text-sm text-left">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. 保留所有权利. 
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS订阅源</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>
        <div class="text-center mt-2">
            由
            <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
            <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a>
            强力驱动.
        </div>
    </div>
    <div class="flex flex-col items-center">
        <span class="transition text-[var(--primary)] font-medium">使用Cloudflare Pages部署</span>
        <a href="https://www.cloudflare.com" target="_blank" rel="noopener noreferrer" class="mt-2">
            <Image src={cflogo} alt="Cloudflare Logo" width="170" />
        </a>
    </div>
</div>