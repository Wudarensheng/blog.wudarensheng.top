---
interface Props {
  repo: string;
  repoId: string;
  category: string;
  categoryId: string;
  mapping?: string;
  reactionsEnabled?: boolean;
  emitMetadata?: boolean;
  inputPosition?: 'top' | 'bottom';
  lang?: string;
}

const {
  repo = 'Wudarensheng/blog-giscus',
  repoId = 'R_kgDOQNnTrw',
  category = 'Announcements',
  categoryId = 'DIC_kwDOQNnTr84CxWgP',
  mapping = 'pathname',
  reactionsEnabled = true,
  emitMetadata = false,
  inputPosition = 'bottom',
  lang = 'zh-CN'
} = Astro.props;
---

<div id="giscus-container"></div>

<style>
  /* Giscus 评论系统美化 - 半透明黑色主题 */
  .giscus, .giscus-frame {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
  }

  /* 评论头部 */
  .giscus .giscus-header {
    background: rgba(0, 0, 0, 0.8) !important;
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
  }

  /* 评论主体背景 */
  .giscus .giscus-comments {
    background: rgba(15, 15, 15, 0.85) !important;
    backdrop-filter: blur(8px);
  }

  /* 单个评论项 */
  .giscus .giscus-comment {
    background: rgba(30, 30, 30, 0.7) !important;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    margin: 1rem 0;
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  .giscus .giscus-comment:hover {
    background: rgba(40, 40, 40, 0.8) !important;
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  /* 评论元信息（作者、时间） */
  .giscus .giscus-comment-header {
    color: rgba(255, 255, 255, 0.7) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.8rem;
    margin-bottom: 1rem;
  }

  /* 评论作者 */
  .giscus .giscus-comment-author {
    color: rgba(255, 255, 255, 0.95) !important;
    font-weight: 600;
  }

  /* 评论时间 */
  .giscus .giscus-comment-timestamp {
    color: rgba(255, 255, 255, 0.5) !important;
  }

  /* 评论内容 */
  .giscus .giscus-comment-content {
    color: rgba(255, 255, 255, 0.9) !important;
    line-height: 1.7;
  }

  /* Markdown 内容样式 */
  .giscus .giscus-comment-content p {
    color: rgba(255, 255, 255, 0.85) !important;
  }

  .giscus .giscus-comment-content a {
    color: rgba(100, 160, 255, 0.9) !important;
    text-decoration: none;
    border-bottom: 1px solid rgba(100, 160, 255, 0.3);
    transition: all 0.2s ease;
  }

  .giscus .giscus-comment-content a:hover {
    color: rgba(120, 180, 255, 1) !important;
    border-bottom-color: rgba(120, 180, 255, 0.7);
  }

  .giscus .giscus-comment-content code {
    background: rgba(0, 0, 0, 0.4) !important;
    color: rgba(255, 100, 100, 0.9) !important;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: 'Monaco', 'Consolas', monospace;
  }

  /* 评论输入区域 */
  .giscus .giscus-textarea {
    background: rgba(25, 25, 25, 0.8) !important;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 10px !important;
    color: rgba(255, 255, 255, 0.9) !important;
    padding: 1rem !important;
    transition: all 0.3s ease;
  }

  .giscus .giscus-textarea:focus {
    background: rgba(35, 35, 35, 0.9) !important;
    border-color: rgba(100, 160, 255, 0.5) !important;
    box-shadow: 0 0 0 3px rgba(100, 160, 255, 0.1);
    outline: none;
  }

  /* 预览区域 */
  .giscus .preview-content {
    background: rgba(20, 20, 20, 0.8) !important;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 1rem;
  }

  /* 按钮样式 */
  .giscus button {
    background: rgba(40, 40, 40, 0.9) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: rgba(255, 255, 255, 0.9) !important;
    border-radius: 8px !important;
    padding: 0.5rem 1.2rem !important;
    transition: all 0.2s ease;
  }

  .giscus button:hover {
    background: rgba(60, 60, 60, 0.9) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
    transform: translateY(-1px);
  }

  .giscus .giscus-button-primary {
    background: linear-gradient(135deg, rgba(80, 80, 200, 0.9), rgba(100, 100, 220, 0.9)) !important;
    border-color: rgba(100, 100, 220, 0.3) !important;
  }

  .giscus .giscus-button-primary:hover {
    background: linear-gradient(135deg, rgba(100, 100, 220, 0.95), rgba(120, 120, 240, 0.95)) !important;
  }

  /* 回复按钮 */
  .giscus .giscus-reply-button {
    color: rgba(100, 160, 255, 0.9) !important;
    background: rgba(100, 160, 255, 0.1) !important;
    border: none !important;
  }

  /* 表情反应区域 */
  .giscus .giscus-reactions {
    background: rgba(0, 0, 0, 0.5) !important;
    border-radius: 20px;
    padding: 0.5rem 1rem;
    margin-top: 1rem;
  }

  /* 加载动画 */
  .giscus .giscus-loading {
    color: rgba(255, 255, 255, 0.6) !important;
  }

  /* 滚动条美化 */
  .giscus ::-webkit-scrollbar {
    width: 8px;
  }

  .giscus ::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
  }

  .giscus ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  .giscus ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* 响应式设计 */
  @media (max-width: 768px) {
    .giscus .giscus-comment {
      padding: 1rem;
      margin: 0.8rem 0;
    }
    
    .giscus .giscus-header {
      padding: 1rem;
    }
  }

  /* 为深色模式优化 */
  :global(.dark) .giscus {
    --giscus-color: rgba(255, 255, 255, 0.9) !important;
    --giscus-background-color: rgba(15, 15, 15, 0.85) !important;
    --giscus-border-color: rgba(255, 255, 255, 0.1) !important;
  }

  /* 为浅色模式优化 */
  :global(:not(.dark)) .giscus {
    --giscus-color: rgba(0, 0, 0, 0.9) !important;
    --giscus-background-color: rgba(255, 255, 255, 0.95) !important;
    --giscus-border-color: rgba(0, 0, 0, 0.1) !important;
  }
</style>

<script define:vars={{ repo, repoId, category, categoryId, mapping, reactionsEnabled, emitMetadata, inputPosition, lang }}>
  function loadGiscus() {
    const container = document.getElementById('giscus-container');
    if (!container) return;

    const isDark = document.documentElement.classList.contains('dark');
    const theme = isDark ? 'dark' : 'light';

    // 移除旧的giscus脚本（如果存在）
    const oldScript = container.querySelector('script[src*="giscus"]');
    if (oldScript) {
      oldScript.remove();
    }

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', repo);
    script.setAttribute('data-repo-id', repoId);
    script.setAttribute('data-category', category);
    script.setAttribute('data-category-id', categoryId);
    script.setAttribute('data-mapping', mapping);
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', reactionsEnabled ? '1' : '0');
    script.setAttribute('data-emit-metadata', emitMetadata ? '1' : '0');
    script.setAttribute('data-input-position', inputPosition);
    script.setAttribute('data-theme', theme);
    script.setAttribute('data-lang', lang);
    script.setAttribute('data-loading', 'lazy');
    script.crossOrigin = 'anonymous';
    script.async = true;

    container.appendChild(script);
  }

  // 监听主题变化
  function updateGiscusTheme() {
    const giscusFrame = document.querySelector('iframe[src*="giscus"]');
    if (giscusFrame && giscusFrame.contentWindow) {
      const isDark = document.documentElement.classList.contains('dark');
      const theme = isDark ? 'dark' : 'light';

      try {
        giscusFrame.contentWindow.postMessage({
          giscus: {
            setConfig: {
              theme: theme
            }
          }
        }, 'https://giscus.app');
      } catch (e) {
        console.log('Giscus主题切换失败，将重新加载');
        loadGiscus(); // 如果postMessage失败，重新加载整个组件
      }
    }
  }

  // 页面加载时初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadGiscus);
  } else {
    loadGiscus();
  }

  // 监听主题变化
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
        // 延迟执行，确保DOM已更新
        setTimeout(updateGiscusTheme, 100);
      }
    }
  });

  // 开始观察主题变化
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });

  // 添加resize监听，确保Giscus响应式
  window.addEventListener('resize', () => {
    const giscusFrame = document.querySelector('iframe[src*="giscus"]');
    if (giscusFrame) {
      giscusFrame.style.width = '100%';
    }
  });
</script>