---
interface Props {
  repo: string;
  repoId: string;
  category: string;
  categoryId: string;
  mapping?: string;
  reactionsEnabled?: boolean;
  emitMetadata?: boolean;
  inputPosition?: 'top' | 'bottom';
  lang?: string;
}

const {
  repo = 'Wudarensheng/blog-giscus',
  repoId = 'R_kgDOQNnTrw',
  category = 'Announcements',
  categoryId = 'DIC_kwDOQNnTr84CxWgP',
  mapping = 'pathname',
  reactionsEnabled = true,
  emitMetadata = false,
  inputPosition = 'bottom',
  lang = 'zh-CN'
} = Astro.props;
---

<!-- Giscus 评论容器 -->
<div class="giscus"></div>

<!-- 加载 Giscus 的静态脚本 -->
<script is:inline>
  // 页面加载完成后初始化 Giscus
  document.addEventListener('DOMContentLoaded', function() {
    // 检测当前主题
    const isDark = document.documentElement.classList.contains('dark');
    const theme = isDark ? 'dark_dimmed' : 'light';
    
    // 创建 Giscus script 元素
    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';
    
    // 设置 data 属性
    script.setAttribute('data-repo', '${repo}');
    script.setAttribute('data-repo-id', '${repoId}');
    script.setAttribute('data-category', '${category}');
    script.setAttribute('data-category-id', '${categoryId}');
    script.setAttribute('data-mapping', '${mapping}');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '${reactionsEnabled ? "1" : "0"}');
    script.setAttribute('data-emit-metadata', '${emitMetadata ? "1" : "0"}');
    script.setAttribute('data-input-position', '${inputPosition}');
    script.setAttribute('data-theme', theme);
    script.setAttribute('data-lang', '${lang}');
    script.setAttribute('data-loading', 'lazy');
    
    // 添加错误处理
    script.onerror = function() {
      console.error('Failed to load Giscus comments');
      const container = document.querySelector('.giscus');
      if (container) {
        container.innerHTML = '<p style="text-align:center;color:#666;">评论加载失败，请稍后重试</p>';
      }
    };
    
    // 插入到页面中
    const container = document.querySelector('.giscus');
    if (container) {
      container.appendChild(script);
    }
  });
  
  // 监听主题变化，重新加载 Giscus
  function handleThemeChange() {
    const isDark = document.documentElement.classList.contains('dark');
    const theme = isDark ? 'dark_dimmed' : 'light';
    const giscusFrame = document.querySelector('iframe.giscus-frame');
    
    if (giscusFrame && giscusFrame.contentWindow) {
      try {
        giscusFrame.contentWindow.postMessage(
          {
            giscus: {
              setConfig: {
                theme: theme
              }
            }
          },
          'https://giscus.app'
        );
      } catch (e) {
        console.log('Giscus theme update sent');
      }
    }
  }
  
  // 使用 MutationObserver 监听主题变化
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.attributeName === 'class') {
        // 延迟执行，确保主题已完全切换
        setTimeout(handleThemeChange, 100);
      }
    });
  });
  
  // 开始观察文档元素的类变化
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });
</script>

<!-- 备用样式，确保评论区域有合适的显示 -->
<style>
  .giscus {
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  
  .giscus iframe {
    min-height: 400px;
    width: 100%;
    border: none;
  }
  
  /* 加载状态提示 */
  .giscus::before {
    content: "正在加载评论...";
    display: block;
    text-align: center;
    color: #666;
    padding: 2rem;
    font-style: italic;
  }
  
  .giscus.loaded::before {
    display: none;
  }
</style>

<script is:inline>
  // 添加加载状态管理
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.querySelector('.giscus');
    
    // 监听 Giscus 加载完成事件
    window.addEventListener('message', function(event) {
      if (event.origin === 'https://giscus.app' && event.data.giscus) {
        if (event.data.giscus.discussion) {
          container.classList.add('loaded');
        }
      }
    });
  });
</script>