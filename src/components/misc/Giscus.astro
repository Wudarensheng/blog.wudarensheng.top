---
// src/components/misc/Giscus.astro
interface Props {
	repo: string;
	repoId: string;
	category: string;
	categoryId: string;
	mapping?: "pathname" | "url" | "title" | "og:title" | "specific" | "number";
	term?: string;
	reactionsEnabled?: boolean;
	emitMetadata?: boolean;
	inputPosition?: "top" | "bottom";
	lang?: string;
	giscusHost?: string;
}

const {
	repo,
	repoId,
	category,
	categoryId,
	mapping = "pathname",
	term,
	reactionsEnabled = true,
	emitMetadata = false,
	inputPosition = "bottom",
	lang = "zh-CN",
	giscusHost = "https://giscus.app",
} = Astro.props;

// 根据亮/暗模式决定 giscus 的主题
const theme = "light"; // 默认主题
---

<div id="giscus-container" class="giscus"></div>

<script define:vars={{ repo, repoId, category, categoryId, mapping, term, reactionsEnabled, emitMetadata, inputPosition, lang, giscusHost }}>
  const GISCUS_APP = giscusHost;

  // 函数：加载 giscus 脚本
  function loadGiscus() {
    const container = document.getElementById('giscus-container');
    if (!container) {
      console.error('Giscus container not found.');
      return;
    }

    // 清理可能存在的旧 giscus 实例
    while (container.firstChild) {
      container.removeChild(container.firstChild);
    }

    // 动态创建 script 标签
    const giscusScript = document.createElement('script');

    // 设置 giscus 参数
    const attributes = {
      'src': `${GISCUS_APP}/client.js`,
      'data-repo': repo,
      'data-repo-id': repoId,
      'data-category': category,
      'data-category-id': categoryId,
      'data-mapping': mapping,
      'data-strict': '0',
      'data-reactions-enabled': reactionsEnabled ? '1' : '0',
      'data-emit-metadata': emitMetadata ? '1' : '0',
      'data-input-position': inputPosition,
      'data-lang': lang,
      'crossorigin': 'anonymous',
      'async': '',
    };

    // 根据当前页面的亮/暗模式设置 giscus 主题
    const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    attributes['data-theme'] = currentTheme;

    if (mapping === 'specific' && term) {
      attributes['data-term'] = term;
    }

    // 将属性应用到 script 标签
    for (const [key, value] of Object.entries(attributes)) {
      giscusScript.setAttribute(key, value);
    }

    // 将脚本注入到容器中
    container.appendChild(giscusScript);
  }

  // 函数：更新 giscus 主题
  function updateGiscusTheme() {
    const iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe) return;

    const currentTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    iframe.contentWindow.postMessage({ giscus: { setConfig: { theme: currentTheme } } }, GISCUS_APP);
  }

  // Astro 视图过渡事件：在页面导航后重新加载 giscus
  document.addEventListener('astro:after-swap', () => {
    // 确保在 DOM 更新后执行
    setTimeout(loadGiscus, 0);
  });

  // 初始加载
  loadGiscus();

  // 设置 MutationObserver 来监听 <html> 元素 class 的变化（主题切换）
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.attributeName === 'class') {
        updateGiscusTheme();
        break;
      }
    }
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });

</script>
