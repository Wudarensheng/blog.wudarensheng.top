---
interface Props {
  repo: string;
  repoId: string;
  category: string;
  categoryId: string;
  mapping?: string;
  reactionsEnabled?: boolean;
  emitMetadata?: boolean;
  inputPosition?: 'top' | 'bottom';
  lang?: string;
}

const {
  repo = 'Wudarensheng/blog-giscus',
  repoId = 'R_kgDOQNnTrw',
  category = 'Announcements',
  categoryId = 'DIC_kwDOQNnTr84CxWgP',
  mapping = 'pathname',
  reactionsEnabled = true,
  emitMetadata = false,
  inputPosition = 'bottom',
  lang = 'zh-CN'
} = Astro.props;
---

<!-- Giscus 评论容器 -->
<div id="giscus-container" class="giscus-container">
  <div class="giscus-loading">正在加载评论系统...</div>
</div>

<!-- 备用评论系统提示 -->
<div id="giscus-fallback" class="giscus-fallback" style="display: none;">
  <p>评论系统暂时无法加载，您可以通过 <a href="https://github.com/Wudarensheng/blog-giscus/discussions" target="_blank">GitHub Discussions</a> 参与讨论。</p>
</div>

<!-- 主脚本 -->
<script is:inline>
  (function() {
    // 配置对象
    const config = {
      repo: '${repo}',
      repoId: '${repoId}',
      category: '${category}',
      categoryId: '${categoryId}',
      mapping: '${mapping}',
      strict: '0',
      reactionsEnabled: '${reactionsEnabled ? "1" : "0"}',
      emitMetadata: '${emitMetadata ? "1" : "0"}',
      inputPosition: '${inputPosition}',
      theme: 'preferred_color_scheme', // 使用系统偏好主题
      lang: '${lang}',
      loading: 'lazy',
      crossorigin: 'anonymous'
    };
    
    // 创建 script 元素
    function createGiscusScript() {
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      
      // 设置所有 data 属性
      Object.keys(config).forEach(key => {
        if (key !== 'crossorigin') {
          script.setAttribute(`data-${key.replace(/([A-Z])/g, '-$1').toLowerCase()}`, config[key]);
        }
      });
      
      return script;
    }
    
    // 加载 Giscus
    function loadGiscus() {
      const container = document.getElementById('giscus-container');
      if (!container) return;
      
      // 检查是否已加载
      if (document.querySelector('iframe.giscus-frame')) {
        return;
      }
      
      // 创建并添加 script
      const script = createGiscusScript();
      
      // 添加超时处理
      const timeoutId = setTimeout(() => {
        showFallback();
      }, 10000); // 10秒超时
      
      script.onload = function() {
        clearTimeout(timeoutId);
        console.log('Giscus loaded successfully');
      };
      
      script.onerror = function(error) {
        clearTimeout(timeoutId);
        console.error('Failed to load Giscus:', error);
        showFallback();
        
        // 尝试备用方案
        setTimeout(tryAlternativeMethod, 2000);
      };
      
      container.appendChild(script);
    }
    
    // 显示备用方案
    function showFallback() {
      const container = document.getElementById('giscus-container');
      const fallback = document.getElementById('giscus-fallback');
      
      if (container) {
        container.style.display = 'none';
      }
      
      if (fallback) {
        fallback.style.display = 'block';
      }
    }
    
    // 尝试替代加载方法
    function tryAlternativeMethod() {
      console.log('Trying alternative loading method...');
      
      // 方法1: 使用 iframe 直接加载
      const iframe = document.createElement('iframe');
      iframe.src = `https://giscus.app/client.html?repo=${encodeURIComponent(config.repo)}&repo-id=${config.repoId}&category=${encodeURIComponent(config.category)}&category-id=${config.categoryId}&theme=${config.theme}&lang=${config.lang}`;
      iframe.width = '100%';
      iframe.height = '400';
      iframe.frameBorder = '0';
      iframe.scrolling = 'no';
      iframe.loading = 'lazy';
      iframe.title = 'Comments';
      iframe.className = 'giscus-frame';
      iframe.sandbox = 'allow-scripts allow-same-origin allow-popups allow-forms';
      iframe.allow = 'clipboard-write';
      iframe.style.border = 'none';
      iframe.style.minHeight = '400px';
      
      const container = document.getElementById('giscus-container');
      if (container) {
        container.innerHTML = '';
        container.appendChild(iframe);
        
        // 监听 iframe 加载
        iframe.onload = function() {
          console.log('Giscus iframe loaded successfully');
        };
        
        iframe.onerror = function() {
          console.error('Giscus iframe failed to load');
          showFallback();
        };
      }
    }
    
    // 检查网络连接
    function checkNetwork() {
      return navigator.onLine;
    }
    
    // 初始化
    function init() {
      if (!checkNetwork()) {
        console.warn('No network connection available');
        showFallback();
        return;
      }
      
      // 延迟加载，确保页面主要内容已加载
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          setTimeout(loadGiscus, 1000); // 延迟1秒加载
        });
      } else {
        setTimeout(loadGiscus, 1000);
      }
    }
    
    // 主题切换处理（轻量级）
    function handleThemeChange() {
      const giscusFrame = document.querySelector('iframe.giscus-frame');
      if (giscusFrame && giscusFrame.contentWindow) {
        try {
          const isDark = document.documentElement.classList.contains('dark');
          const theme = isDark ? 'dark_dimmed' : 'light';
          
          giscusFrame.contentWindow.postMessage(
            {
              giscus: {
                setConfig: {
                  theme: theme
                }
              }
            },
            'https://giscus.app'
          );
        } catch (e) {
          // 静默处理错误
        }
      }
    }
    
    // 启动
    init();
    
    // 监听主题变化（可选，如果不需要可以移除）
    if (typeof MutationObserver !== 'undefined') {
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.attributeName === 'class') {
            setTimeout(handleThemeChange, 300);
          }
        });
      });
      
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class']
      });
    }
  })();
</script>

<style>
  .giscus-container {
    margin: 3rem 0;
    min-height: 400px;
    position: relative;
  }
  
  .giscus-loading {
    text-align: center;
    padding: 3rem;
    color: #666;
    font-style: italic;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
    border-radius: 8px;
  }
  
  .dark .giscus-loading {
    background: linear-gradient(90deg, #2d2d2d 25%, #3d3d3d 50%, #2d2d2d 75%);
    color: #aaa;
  }
  
  @keyframes loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  
  .giscus-fallback {
    text-align: center;
    padding: 2rem;
    background-color: #f8f9fa;
    border-radius: 8px;
    border: 1px solid #e9ecef;
    margin: 2rem 0;
  }
  
  .dark .giscus-fallback {
    background-color: #2d2d2d;
    border-color: #404040;
    color: #e0e0e0;
  }
  
  .giscus-fallback a {
    color: #0969da;
    text-decoration: none;
    font-weight: 500;
  }
  
  .dark .giscus-fallback a {
    color: #58a6ff;
  }
  
  .giscus-fallback a:hover {
    text-decoration: underline;
  }
  
  .giscus-frame {
    min-height: 400px;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }
</style>